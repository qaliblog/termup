    "box64-layer": {
        "description": "Transparent Box64 execution layer: termup-wrap64 (installed in the guest at /usr/local/bin) replaces every x86_64 ELF executable with the ARM64 termup-x86_64-launcher (original moves to <dir>/.termup-x86_64/), so x86_64 binaries run through box64 for every exec path (execve, execvp, posix_spawn, JDK jspawnhelper) with no LD_PRELOAD, and native ARM64 binaries are never touched. Replaces the legacy libbox64auto.so LD_PRELOAD interposer, which JDK 17's ProcessBuilder (jspawnhelper -> execvp) bypassed.",
        "version": "2.0.0",
        "architecture": "aarch64",
        "install_method": "prebuilt_binary",
        "required_for_offline": true,
        "license": "MIT",
        "source": "local (termup-assets/prebuilt/box64/termup-x86_64-launcher.c)",
        "notes": "Committed as a prebuilt binary because the asset pipeline has no NDK access. Rebuild: aarch64-linux-android24-clang -O2 -static -s -o termup-x86_64-launcher termup-x86_64-launcher.c",
        "destination": "box64/termup-x86_64-launcher"
    },
    "box64-wrapd": {
        "description": "Continuous Box64 wrap watcher daemon: runs on the host at session start (backgrounded by termup-ubuntu), watches the Gradle transform cache, .android and the guest /usr dirs with inotify and wraps any x86_64 ELF executable the instant it is written or moved in - covering AGP re-extracting aapt2/aidl/zipalign into fresh ~/.gradle/caches/<ver>/transforms dirs mid-build - plus a periodic full sweep. Single-instance via flock.",
        "version": "1.0.0",
        "architecture": "aarch64",
        "install_method": "prebuilt_binary",
        "required_for_offline": true,
        "license": "MIT",
        "source": "local (termup-assets/prebuilt/box64/termup-wrapd.c)",
        "notes": "Committed as a prebuilt binary because the asset pipeline has no NDK access. Rebuild: aarch64-linux-android24-clang -O2 -static -s -o termup-wrapd termup-wrapd.c",
        "destination": "box64/termup-wrapd"
    },
